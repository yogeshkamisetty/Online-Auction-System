# Database Connection (Neon Serverless PostgreSQL or local PostgreSQL)
# Transaction mode (Pooled) - Used by Prisma Client for app queries
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Direct connection - Used for running Prisma migrations
DIRECT_URL="postgresql://username:password@ep-sample.us-east-1.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication
JWT_SECRET="super-secret-jwt-key-replace-in-production"
JWT_EXPIRES_IN="7d"

# Server Port
PORT=3001
